<Window x:Class="GnuSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls"
        Title="Funnel">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Icon.png" Width="22" Height="22" />
                    <TextBlock Text="Funnel"
                               FontWeight="SemiBold"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Opacity="0.75"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Text="Ready" />

                <TextBlock x:Name="WatchLabel"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Opacity="0.75"
                           FontSize="12" />

                <ToggleButton x:Name="WatchToggle"
                              Grid.Column="3"
                              MinWidth="150"
                              Click="WatchToggle_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock x:Name="WatchText" Text="Watch folders" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Top tabs mirror the Linux header switcher (Folders · Rules ·
             Activity), with the built-in Settings item as the gear on the right. -->
        <controls:NavigationView x:Name="NavView"
                                 Grid.Row="1"
                                 IsBackButtonVisible="Collapsed"
                                 IsPaneToggleButtonVisible="False"
                                 PaneDisplayMode="Top"
                                 IsSettingsVisible="True"
                                 SelectionChanged="NavView_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="Folders" Tag="FoldersView" IsSelected="True">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Rules" Tag="RulesView">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Activity" Tag="ActivityView">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <Frame x:Name="ContentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </controls:NavigationView>
    </Grid>
</Window>

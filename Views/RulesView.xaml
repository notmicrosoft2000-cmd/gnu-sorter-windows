<Page x:Class="GnuSorter.Views.RulesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="Rules" FontSize="24" FontWeight="SemiBold"/>
            <TextBox PlaceholderText="Search rules" Width="240"/>
            <Button Content="Add rule" Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="Advanced editor..."/>
            <Button Content="Apply preset"/>
        </StackPanel>

        <ListView x:Name="FoldersPane" Grid.Row="1" Grid.Column="0"/>
        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel Spacing="12">
                <ToggleSwitch Header="Use default rules" IsOn="True"/>
                <Expander Header="File extensions" IsExpanded="True">
                    <ListView x:Name="ExtRules"/>
                </Expander>
                <Expander Header="Name matching (advanced)" IsExpanded="True">
                    <ListView x:Name="NameRules"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

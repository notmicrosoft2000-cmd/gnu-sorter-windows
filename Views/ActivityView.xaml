<Page x:Class="GnuSorter.Views.ActivityView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Activity"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button x:Name="UndoButton" Click="Undo_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Undo" />
                    <TextBlock Text="Undo last" />
                </StackPanel>
            </Button>
            <Button x:Name="UndoSweepButton" Click="UndoSweep_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Undo" />
                    <TextBlock Text="Undo last sweep" />
                </StackPanel>
            </Button>
            <Button Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search file name"
                     Width="200"
                     TextChanged="Search_TextChanged" />
            <ComboBox x:Name="RuleFilter"
                      MinWidth="150"
                      SelectionChanged="RuleFilter_SelectionChanged" />
            <Button x:Name="RestoreButton" Click="Restore_Click"
                    ToolTipService.ToolTip="Preview and restore the matching files">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Undo" />
                    <TextBlock Text="Restore…" />
                </StackPanel>
            </Button>
            <Button x:Name="BackupButton" Click="Backup_Click">Back up</Button>
            <Button x:Name="ExportButton" Click="Export_Click">Export…</Button>
            <Button x:Name="ImportButton" Click="Import_Click">Import…</Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <TextBox x:Name="ExtFilterBox"
                     PlaceholderText="Extension (e.g. jpg)"
                     Width="150"
                     TextChanged="Search_TextChanged" />
            <TextBox x:Name="MinSizeBox"
                     PlaceholderText="Min size (e.g. 1M)"
                     Width="140"
                     TextChanged="Search_TextChanged" />
            <TextBox x:Name="MaxSizeBox"
                     PlaceholderText="Max size (e.g. 500M)"
                     Width="140"
                     TextChanged="Search_TextChanged" />
            <TextBlock Text="On conflict" VerticalAlignment="Center" Opacity="0.8" />
            <ComboBox x:Name="ConflictChoice" MinWidth="130">
                <ComboBoxItem Content="Rename" Tag="rename" IsSelected="True" />
                <ComboBoxItem Content="Overwrite" Tag="overwrite" />
                <ComboBoxItem Content="Skip" Tag="skip" />
            </ComboBox>
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="4">
            <ListView x:Name="ActivityList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Rule}" Opacity="0.55" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Time}" Opacity="0.6"
                                       FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyHint"
                       Text="Nothing has been sorted yet."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       Visibility="Collapsed" />
        </Grid>

        <TextBlock x:Name="Footnote"
                   Grid.Row="5"
                   FontSize="12"
                   Opacity="0.6"
                   TextWrapping="Wrap" />
    </Grid>
</Page>

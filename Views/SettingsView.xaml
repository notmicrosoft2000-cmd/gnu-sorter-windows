<Page x:Class="GnuSorter.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="Behavior" Style="{StaticResource SubtitleTextBlockStyle}" />

            <NumberBox Header="Stability window (seconds)"
                       Minimum="0"
                       Maximum="60"
                       SpinButtonPlacementMode="Compact"
                       Value="{x:Bind ViewModel.MinStableSeconds, Mode=TwoWay}" />

            <NumberBox Header="Stability check interval (seconds)"
                       Minimum="0.1"
                       Maximum="10"
                       SmallChange="0.1"
                       SpinButtonPlacementMode="Compact"
                       Value="{x:Bind ViewModel.StabilityInterval, Mode=TwoWay}" />

            <NumberBox Header="Watcher poll interval (seconds)"
                       Minimum="0.5"
                       Maximum="30"
                       SpinButtonPlacementMode="Compact"
                       Value="{x:Bind ViewModel.WatchInterval, Mode=TwoWay}" />

            <ToggleSwitch Header="Show notifications"
                          IsOn="{x:Bind ViewModel.Notifications, Mode=TwoWay}" />

            <ToggleSwitch Header="Dry-run by default (Sort now previews only)"
                          IsOn="{x:Bind ViewModel.DryRunDefault, Mode=TwoWay}" />

            <ToggleSwitch Header="Start Funnel when I sign in"
                          IsOn="{x:Bind ViewModel.StartOnLogin, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save settings"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Save_Click" />
                <Button Content="Reload" Click="Reload_Click" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Spacing="10">
                <Button x:Name="UpdateButton" Content="Check for updates" Click="Update_Click" />
                <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Opacity="0.8"
                           FontFamily="Segoe UI" />
            </StackPanel>

            <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Funnel for Windows" FontWeight="SemiBold" />
            <TextBlock Text="Version 2.5.0 · by notmicrosoft2000-cmd" Opacity="0.8" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="An advanced file-sorting utility. Define rules per folder and let them organize incoming files automatically." />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <HyperlinkButton Content="GitHub repository"
                                 NavigateUri="https://github.com/notmicrosoft2000-cmd/gnu-sorter" />
                <HyperlinkButton Content="Report an issue"
                                 NavigateUri="https://github.com/notmicrosoft2000-cmd/gnu-sorter/issues" />
                <HyperlinkButton Content="Website"
                                 NavigateUri="https://notmicrosoft2000-cmd.github.io/gnu-sorter/" />
            </StackPanel>

            <TextBlock Text="Configuration" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Your rules, folders and settings live in:" Opacity="0.8" />
            <TextBlock Text="{x:Bind ViewModel.ConfigPath}"
                       IsTextSelectionEnabled="True"
                       FontFamily="Consolas"
                       Opacity="0.8" />
            <Button Content="Open config folder" Click="OpenConfig_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
